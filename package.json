{
  "name": "tadhanasmp-community",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke",
    "smoke": "node scripts/smoke.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:cleanup": "node scripts/cleanup-auth.mjs",
    "db:redact-legacy": "node scripts/redact-legacy-otp.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "@prisma/client": "6.19.3",
    "lucide-react": "1.55.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource-variable/inter": "5.3.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "6.19.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
